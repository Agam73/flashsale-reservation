# --- Postgres (Phase 3) ---
DATABASE_URL=postgres://flashsale:flashsale@localhost:5432/flashsale?sslmode=disable

# --- Redis (Phase 4+) ---
# Match whatever host/port your docker-compose.yml exposes Redis on.
REDIS_ADDR=localhost:6379

# --- waiting-room-api ---
WAITING_ROOM_API_PORT=8081
# Admissions per second, per item. One rate applies to every item in
# this phase -- per-item rates are a later-phase concern.
ADMIT_RATE_PER_SEC=5
# How long an admission token stays valid in Redis before checkout-api
# has to have consumed it.
ADMISSION_TTL_SECONDS=120

# --- checkout-api ---
CHECKOUT_API_PORT=8082
# checkout-api's first Postgres dependency (Phase 9): how often it
# re-seeds Redis's fast-path inventory counters from
# items.available_inventory, on top of the one-time seed it does at
# startup before accepting traffic.
INVENTORY_RECONCILE_INTERVAL_SECONDS=30

# --- Kafka (Phase 6+) ---
# Comma-separated if you ever run multiple brokers.
KAFKA_BROKERS=localhost:9092

# --- decision-service ---
DECISION_SERVICE_PORT=8083
KAFKA_CONSUMER_GROUP=decision-service
# How long a reservation holds inventory before expiry-worker (Phase 7)
# is expected to release it. Separate from ADMISSION_TTL_SECONDS above --
# that one bounds the waiting-room token, this one bounds the actual
# reservation.
RESERVATION_TTL_SECONDS=120
# Retry policy (Phase 8) for messages whose processing error is NOT
# classified as a connectivity failure (see docs/phase8.md). Leave
# unset to use internal/retry.DefaultPolicy()'s values.
DECISION_MAX_RETRIES=5
DECISION_MAX_RETRY_ELAPSED_SECONDS=120

# --- expiry-worker (Phase 7) ---
EXPIRY_WORKER_PORT=8084
EXPIRY_SCAN_INTERVAL_SECONDS=5
EXPIRY_SCAN_BATCH_SIZE=100
EXPIRY_WORKER_POOL_SIZE=4
