/cmd/*/waiting-room-api
/cmd/*/checkout-api
/cmd/*/decision-service
/cmd/*/expiry-worker
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
go.work
go.work.sum

# --- Python (services/risk-service) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docker / local data ---
